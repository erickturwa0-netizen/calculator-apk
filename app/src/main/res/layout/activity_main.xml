<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp">

    <!-- Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:paddingBottom="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#AAAAAA"
            android:textSize="22sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start" />

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false">

        <!-- Row 1 -->
        <Button android:id="@+id/btnClear" style="@style/CalcButton.Function" android:text="C" />
        <Button android:id="@+id/btnBackspace" style="@style/CalcButton.Function" android:text="⌫" />
        <Button android:id="@+id/btnPercent" style="@style/CalcButton.Function" android:text="%" />
        <Button android:id="@+id/btnDivide" style="@style/CalcButton.Operator" android:text="÷" />

        <!-- Row 2 -->
        <Button android:id="@+id/btn7" style="@style/CalcButton.Number" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalcButton.Number" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalcButton.Number" android:text="9" />
        <Button android:id="@+id/btnMultiply" style="@style/CalcButton.Operator" android:text="×" />

        <!-- Row 3 -->
        <Button android:id="@+id/btn4" style="@style/CalcButton.Number" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalcButton.Number" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalcButton.Number" android:text="6" />
        <Button android:id="@+id/btnMinus" style="@style/CalcButton.Operator" android:text="-" />

        <!-- Row 4 -->
        <Button android:id="@+id/btn1" style="@style/CalcButton.Number" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalcButton.Number" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalcButton.Number" android:text="3" />
        <Button android:id="@+id/btnPlus" style="@style/CalcButton.Operator" android:text="+" />

        <!-- Row 5 -->
        <Button android:id="@+id/btn0" style="@style/CalcButton.Number" android:text="0"
            android:layout_columnSpan="2" />
        <Button android:id="@+id/btnDot" style="@style/CalcButton.Number" android:text="." />
        <Button android:id="@+id/btnEquals" style="@style/CalcButton.Equals" android:text="=" />

    </GridLayout>

</LinearLayout>
