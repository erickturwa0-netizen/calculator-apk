<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Calculator" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#FF9500</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowBackground">#121212</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width="0dp" />
        <item name="android:layout_height"0dp" />
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">40dp</item>
    </style>

    <style name="CalcButton.Number" parent="CalcButton">
        <item name="backgroundTint">#2C2C2C</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalcButton.Function" parent="CalcButton">
        <item name="backgroundTint">#3D3D3D</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalcButton.Operator" parent="CalcButton">
        <item name="backgroundTint">#FF9500</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalcButton.Equals" parent="CalcButton">
        <item name="backgroundTint">#FF9500</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
